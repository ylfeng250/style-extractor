{
  "name": "style-extractor",
  "version": "1.0.0",
  "description": "基于 chrome.debugger 的网页样式精准提取扩展",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:extension": "node build.mjs",
